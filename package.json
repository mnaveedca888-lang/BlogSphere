{
  "name": "blogsphere-cms",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:pages": "node scripts/build-pages.js",
    "check:node": "node scripts/check-node-version.js",
    "test": "node --test",
    "pages:dev": "npm run check:node && npm run build:pages && wrangler pages dev dist --ip 127.0.0.1 --port 8788"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.3",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "wrangler": "^4.160.1"
  }
}
